# Echo Show app (android/): Gradle and Android Studio output, and the SDK location
*.iml
.gradle
/.idea/
/android/.idea/
.kotlin
.DS_Store
/android/build
/android/captures
.externalNativeBuild
.cxx
local.properties

# boot screen: the boot animation and preview frames make_boot_screen.py draws
tools/boot-screen/build/

# mock OctoPrint: dependencies and its throwaway localhost certificate
tools/mock-octoprint/node_modules/
*.pem

# iPhone app: the Xcode project and Info.plist are generated from ios/project.yml by XcodeGen
ios/*.xcodeproj/
ios/OctoShow/Info.plist
ios/Packages/*/.build/
ios/Packages/*/.swiftpm/
xcuserdata/
DerivedData/
# your own bundle identifier and team (see ios/Signing.xcconfig)
ios/Local.xcconfig

# signing keys never belong here
*.jks
*.keystore

# run files written by local tooling
.scp-progress.json
.scp-test-baseline.json
.scp-test-results.json
.scp-implement-errors.log
